  "name": "1 projeto TechFlow B2B",
  "nodes": [
    {
      "parameters": {
        "content": "## Objetivo \nDesenvolver um fluxo no n8n que receba os dados do formulário do site em tempo real, faça a higienização dos dados (evitando duplicidade), qualifique o lead pelo porte da empresa e direcione a notificação para o canal correto.",
        "height": 128,
        "width": 608
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -864,
        -496
      ],
      "typeVersion": 1,
      "id": "e4275fd4-b866-4a2f-9139-6f02a7db6167",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();[cite: 2]\n\nreturn items.map(item => {\n  // Pega os dados originais enviados pelo Webhook\n  const data = $('Webhook').item.json;[cite: 2]\n  \n  // Limpa caracteres não numéricos do telefone\n  const telefoneLimpo = data.telefone ? data.telefone.replace(/\\D/g, '') : '';\n  const qtdFuncionarios = Number(data.qtdFuncionarios) || 0;\n  \n  // Lógica de Porte\n  const isVIP = qtdFuncionarios >= 50;\n  const categoria = isVIP ? 'Lead VIP / Enterprise' : 'Lead SMB / Padrão';\n\n  // Alerta formatado para a equipe técnica/vendas\n  const textoNotificacao = `🚨 *NOVO LEAD VIP DETECTADO* 🚨\\n\\n` +\n                           `🏢 *Empresa:* ${data.empresa || 'Não informada'}\\n` +\n                           `👤 *Contato:* ${data.nome || 'Não informado'}\\n` +\n                           `👥 *Porte:* ${qtdFuncionarios} funcionários\\n` +\n                           `✉️ *E-mail:* ${data.email}\\n` +\n                           `📞 *WhatsApp:* https://wa.me/55${telefoneLimpo}\\n` +\n                           `💬 *Mensagem:* ${data.mensagem || 'Sem mensagem'}`;\n\n  return {\n    json: {\n      timestamp: new Date().toISOString(),\n      nome: data.nome,\n      email: data.email,\n      telefone: telefoneLimpo,\n      empresa: data.empresa,\n      qtdFuncionarios: qtdFuncionarios,\n      mensagem: data.mensagem,\n      categoria: categoria,\n      isVIP: isVIP,\n      mensagemNotificacao: textoNotificacao\n    }\n  };[cite: 2]\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        -160
      ],
      "id": "619197a9-a6b6-43f9-b466-45480650b8f9",
